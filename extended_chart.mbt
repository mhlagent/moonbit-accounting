///|
pub fn extended_chart_for_class(
  class : AccountClass,
) -> Array[AccountDefinition] {
  let result : Array[AccountDefinition] = []
  for account in extended_chart() {
    if account.class == class {
      result.push(account)
    }
  }
  result
}

///|
pub fn find_extended_account(code : String) -> AccountDefinition? {
  for account in extended_chart() {
    if account.code == code {
      return Some(account)
    }
  }
  None
}
