///|
pub fn regional_chart_for_region(region : String) -> Array[AccountDefinition] {
  let result : Array[AccountDefinition] = []
  for account in regional_chart() {
    if account.name.has_prefix(region) {
      result.push(account)
    }
  }
  result
}

///|
pub fn regional_chart_size() -> Int {
  regional_chart().length()
}
